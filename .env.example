# Sao chép thành .env để ghi đè giá trị mặc định trong docker-compose.yml

# Cổng trên máy host
OLTP_PORT=5433
DWH_PORT=5434
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_APP_UI_PORT=4040
METABASE_PORT=3000

# Thông tin đăng nhập
OLTP_DB=shop_oltp
OLTP_USER=oltp
OLTP_PASSWORD=oltp
DWH_DB=shop_dwh
DWH_USER=dwh
DWH_PASSWORD=dwh

# Tài nguyên Spark worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m

# Khối lượng dữ liệu mock
N_CUSTOMERS=5000
N_PRODUCTS=400
N_ORDERS=60000
START_DATE=2024-01-01
